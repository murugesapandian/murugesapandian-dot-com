---
import '../styles/global.css';
import { siteMeta } from '../content/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Set false on pages that shouldn't be indexed (none currently). */
  index?: boolean;
}

const { title = siteMeta.title, description = siteMeta.description, index = true } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteMeta.url);
const ogImageURL = new URL(siteMeta.ogImage, siteMeta.url);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteMeta.name,
  url: siteMeta.url,
  jobTitle: 'Senior Engineering & Product Leader',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bentonville',
    addressRegion: 'AR',
    addressCountry: 'US',
  },
  sameAs: [siteMeta.linkedin, siteMeta.github].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
        document.documentElement.classList.add('js');
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    {!index && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMeta.name} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteMeta.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/main.ts"></script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--color-gold);
    color: var(--color-navy);
    padding: 0.75rem 1.25rem;
    font-weight: 600;
    border-radius: 0 0 0.5rem 0;
  }
  .skip-link:focus {
    left: 0;
  }
</style>
