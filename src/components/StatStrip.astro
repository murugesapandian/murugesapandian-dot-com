---
import { stats } from '../content/site';
---

<dl class="grid grid-cols-2 gap-6 sm:gap-8">
  {stats.map((stat) => (
    <div>
      <dt class="sr-only">{stat.label}</dt>
      <dd
        class="counter font-display text-3xl font-semibold text-gold sm:text-4xl"
        data-value={stat.value}
        data-prefix={stat.prefix ?? ''}
        data-suffix={stat.suffix ?? ''}
      >
        {stat.prefix ?? ''}
        {stat.value}
        {stat.suffix ?? ''}
      </dd>
      <dd class="mt-1 text-sm text-slate/80 dark:text-mist/70">{stat.label}</dd>
    </div>
  ))}
</dl>
