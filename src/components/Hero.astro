---
import { hero, siteMeta } from '../content/site';
import StatStrip from './StatStrip.astro';
import SupplyChainBackdrop from './SupplyChainBackdrop.astro';
---

<section class="relative flex min-h-[100svh] flex-col overflow-hidden bg-navy dark:bg-navy-deep">
  <SupplyChainBackdrop />

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 px-4 pt-20 sm:px-6 lg:flex-row lg:items-end lg:gap-8 lg:px-8 lg:pt-32"
  >
    <div class="order-2 flex flex-1 flex-col justify-center gap-5 pb-10 lg:order-1 lg:gap-6 lg:pb-24">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold">{hero.eyebrow}</p>
      <h1 class="font-display text-4xl font-semibold text-balance text-offwhite sm:text-5xl lg:text-6xl">
        {hero.heading}
      </h1>
      <p class="max-w-prose-wide text-lg text-mist">{hero.sub}</p>

      <div class="flex flex-wrap gap-4">
        <a
          href={hero.ctaPrimary.href}
          class="rounded-full bg-gold px-6 py-3 text-sm font-semibold text-navy transition hover:bg-offwhite"
        >
          {hero.ctaPrimary.label}
        </a>
        <a
          href={hero.ctaSecondary.href}
          target="_blank"
          rel="noreferrer"
          class="rounded-full border border-gold/60 px-6 py-3 text-sm font-semibold text-offwhite transition hover:border-gold hover:text-gold"
        >
          {hero.ctaSecondary.label}
        </a>
      </div>

      <p class="text-sm text-mist/70">{hero.locationLine}</p>

      <div class="mt-2 max-w-md lg:mt-8">
        <StatStrip />
      </div>
    </div>

    <div class="relative order-1 flex flex-1 items-end justify-center pt-6 lg:order-2 lg:justify-end lg:pt-0">
      <picture>
        <source srcset="/images/mp-photo-cutout.webp" type="image/webp" />
        <img
          src="/images/mp-photo-cutout.png"
          alt={siteMeta.name}
          class="h-[56vh] w-auto object-contain object-bottom drop-shadow-2xl sm:h-[62vh] lg:h-[88vh]"
          width="971"
          height="1517"
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
</section>
