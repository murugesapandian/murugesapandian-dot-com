---
import type { Project } from '../content/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="reveal flex h-full flex-col rounded-2xl border border-mist bg-white/60 p-6 transition hover:-translate-y-0.5 hover:shadow-sm dark:border-white/10 dark:bg-white/5">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold">{project.title}</h3>
    {project.tag && (
      <span class="shrink-0 rounded-full bg-gold-soft px-2.5 py-1 font-mono text-[0.65rem] font-medium uppercase tracking-wide text-navy dark:bg-gold/20 dark:text-gold-soft">
        {project.tag}
      </span>
    )}
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate dark:text-mist/85">{project.description}</p>

  <ul class="mt-5 flex flex-wrap gap-2">
    {project.stack.map((item) => (
      <li class="rounded-full border border-mist px-2.5 py-1 font-mono text-[0.7rem] text-slate dark:border-white/15 dark:text-mist/80">
        {item}
      </li>
    ))}
  </ul>
</article>
