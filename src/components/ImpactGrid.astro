---
import { impact } from '../content/site';
---

<section id="impact" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <h2 class="reveal font-display text-3xl font-semibold sm:text-4xl">Impact</h2>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {impact.map((tile) => (
      <div class="reveal rounded-2xl border border-mist bg-white/60 p-6 transition hover:-translate-y-0.5 hover:shadow-sm dark:border-white/10 dark:bg-white/5">
        <p class="font-display text-2xl font-semibold text-gold-ink sm:text-3xl dark:text-gold">
          {tile.value}
        </p>
        <p class="mt-2 text-sm text-slate dark:text-mist/80">{tile.label}</p>
      </div>
    ))}
  </div>
</section>
