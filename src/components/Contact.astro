---
import { contact, siteMeta } from '../content/site';

const links = [
  { label: 'Email', href: `mailto:${siteMeta.email}`, external: false },
  { label: 'LinkedIn', href: siteMeta.linkedin, external: true },
  ...(siteMeta.github ? [{ label: 'GitHub', href: siteMeta.github, external: true }] : []),
  { label: 'Download Résumé', href: contact.resumeHref, external: false },
];
---

<section id="contact" class="bg-gold-soft/30 py-20 dark:bg-white/[0.03]">
  <div class="reveal mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="font-display text-3xl font-semibold sm:text-4xl">{contact.headline}</h2>
    <p class="mt-4 text-base leading-relaxed text-slate dark:text-mist/85">{contact.line}</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {links.map((link, i) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noreferrer' : undefined}
          class={
            i === 0
              ? 'rounded-full bg-navy px-6 py-3 text-sm font-semibold text-offwhite transition hover:bg-gold hover:text-navy dark:bg-gold dark:text-navy dark:hover:bg-offwhite'
              : 'rounded-full border border-mist px-6 py-3 text-sm font-semibold text-slate transition hover:border-gold hover:text-gold dark:border-white/20 dark:text-mist'
          }
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>
