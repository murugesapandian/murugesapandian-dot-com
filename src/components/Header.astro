---
import { nav, siteMeta } from '../content/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-mist/70 bg-offwhite/90 backdrop-blur dark:border-white/10 dark:bg-navy-deep/90">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="#" class="flex items-center gap-2.5 shrink-0" aria-label={siteMeta.name}>
      <span
        class="grid size-9 shrink-0 place-items-center rounded-full border-2 border-gold font-display text-sm font-semibold text-gold-ink dark:text-gold"
        aria-hidden="true"
      >
        MP
      </span>
      <span class="hidden font-display text-base font-medium text-navy sm:inline dark:text-offwhite">
        {siteMeta.name}
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      {nav.map((item) => (
        <a
          data-nav-link
          href={item.href}
          class="text-sm font-medium text-slate transition hover:text-gold-ink aria-[current]:text-gold-ink dark:text-mist dark:hover:text-gold dark:aria-[current]:text-gold"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <ThemeToggle />
      <a
        href="/resume"
        class="rounded-full bg-gold px-4 py-2 text-sm font-semibold text-navy transition hover:bg-navy hover:text-offwhite"
      >
        Download Résumé
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
        class="grid size-9 place-items-center rounded-full border border-mist text-slate dark:border-white/20 dark:text-mist"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    hidden
    class="border-t border-mist/70 px-4 py-4 lg:hidden dark:border-white/10"
  >
    <ul class="flex flex-col gap-4">
      {nav.map((item) => (
        <li>
          <a
            data-nav-link
            href={item.href}
            class="block text-base font-medium text-slate hover:text-gold-ink aria-[current]:text-gold-ink dark:text-mist dark:hover:text-gold dark:aria-[current]:text-gold"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/resume"
          class="block rounded-full bg-gold px-4 py-2 text-center text-sm font-semibold text-navy"
        >
          Download Résumé
        </a>
      </li>
    </ul>
  </nav>
</header>
