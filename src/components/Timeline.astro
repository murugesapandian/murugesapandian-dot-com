---
import { journey } from '../content/journey';
import FlowLine from './FlowLine.astro';
---

<section id="journey" class="bg-navy py-20 dark:bg-navy-deep">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <h2 class="reveal font-display text-3xl font-semibold text-offwhite sm:text-4xl">Career Journey</h2>
    <p class="reveal mt-3 max-w-prose-wide text-slate-300 text-mist/80">Most recent role first.</p>

    <ol class="relative mt-12 space-y-10">
      <div class="absolute left-[7px] top-2 bottom-2 w-0.5 sm:left-[11px]" aria-hidden="true">
        <FlowLine variant="timeline" class="h-full w-full" />
      </div>

      {journey.map((entry) => (
        <li class="reveal relative pl-8 sm:pl-10">
          <span
            class="absolute left-0 top-1.5 size-3.5 rounded-full border-2 border-gold bg-navy sm:size-[22px] sm:left-0.5"
            aria-hidden="true"
          />
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-xl font-semibold text-offwhite">{entry.employer}</h3>
              {entry.period && <span class="font-mono text-xs text-gold">{entry.period}</span>}
            </div>
            {entry.location && <p class="mt-1 text-sm text-mist/60">{entry.location}</p>}

            {entry.title && <p class="mt-3 text-sm font-medium text-gold-soft">{entry.title}</p>}

            {entry.bullets && (
              <ul class="mt-4 space-y-2 text-sm leading-relaxed text-mist/90">
                {entry.bullets.map((bullet) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 size-1 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}

            {entry.comingSoon && <p class="mt-3 text-sm italic text-mist/60">Role details coming soon.</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
