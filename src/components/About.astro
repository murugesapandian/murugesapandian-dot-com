---
import { about } from '../content/site';
---

<section id="about" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="reveal grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
    <div>
      <h2 class="font-display text-3xl font-semibold text-balance sm:text-4xl">{about.headline}</h2>
      <div class="mt-6 space-y-5 max-w-prose-wide text-base leading-relaxed text-slate dark:text-mist/90">
        {about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <aside class="h-fit rounded-2xl border border-mist bg-white/60 p-6 dark:border-white/10 dark:bg-white/5">
      <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-gold-ink dark:text-gold">At a glance</h3>
      <ul class="mt-4 space-y-3 text-sm text-slate dark:text-mist/90">
        {about.atAGlance.map((item) => (
          <li class="flex items-start gap-2">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>
